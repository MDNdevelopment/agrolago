---
import Media from './Media.astro';
import Waves from './Waves.astro';
import type { ImageMetadata } from 'astro';
export interface Props {
  title: string;
  intro?: string;
  image: ImageMetadata;
  /** Fondo de la sección que sigue, para que la ola se funda con ella. */
  next?: 'bg' | 'soft';
}
const { title, intro, image, next = 'bg' } = Astro.props;
---

<section class="page-hero" data-hero-root>
  <div class="page-hero-media" data-hero-media aria-hidden="true">
    <Media src={image} alt="" eager sizes="100vw" />
  </div>
  <div class="page-hero-shade" aria-hidden="true"></div>
  <div class="page-hero-veil" data-hero-veil aria-hidden="true"></div>
  <div class="wrap page-hero-copy">
    <h1 class="h-hero" data-split data-hero>{title}</h1>
    {intro && <p class="lead" data-hero-rest>{intro}</p>}
  </div>
  <Waves placement="hero" tone={next} />
</section>
