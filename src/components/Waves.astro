---
// Olas de tres capas, tomadas del footer del sitio original. Se pintan con el color de la sección
// que "sube" (currentColor) y se mueven despacio. Decorativas: no entran al árbol de accesibilidad.
export interface Props {
  /** top: sobre el borde superior del footer. hero: sobre el borde inferior de una foto de cabecera. */
  placement: 'top' | 'hero';
  /** Color de la sección siguiente al hero (solo placement="hero"). */
  tone?: 'bg' | 'soft';
}
const { placement, tone = 'bg' } = Astro.props;
---

<div class:list={['waves', `waves-${placement}`, { 'is-soft': tone === 'soft' }]} aria-hidden="true">
  <svg viewBox="0 0 1280 140" preserveAspectRatio="none" focusable="false">
    <path class="wave-d" d="M0 96c80 14 170 22 270 22 280 0 360-50 640-50 220 0 300 30 370 46V0H0z"></path>
    <path class="wave-c" d="M0 70c60 18 140 26 240 26 300 0 340-60 640-60 260 0 310 40 400 52V0H0z"></path>
    <path class="wave-e" d="M0 12c60-8 130-12 210-12 300 0 340 62 660 62 230 0 290-34 410-50V0H0z"></path>
    <path class="wave-a" d="M0 51.76c36.21-2.25 77.57-3.58 126.42-3.58 320 0 320 57 640 57 271.15 0 312.58-40.91 513.58-53.4V0H0z"></path>
    <path class="wave-b" d="M0 24.31c43.46-5.69 94.56-9.25 158.42-9.25 320 0 320 89.24 640 89.24 256.13 0 307.28-57.16 481.58-80V0H0z"></path>
    <path d="M0 0v3.4C28.2 1.6 59.4.59 94.42.59c320 0 320 84.3 640 84.3 285 0 316.17-66.85 545.58-81.49V0z"></path>
  </svg>
</div>
