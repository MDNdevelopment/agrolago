---
import { site } from '../config/site';

// Íconos simples en línea. Si no hay ninguna URL cargada en site.social, no renderiza nada.
const icons = {
  facebook: 'M13.5 21v-8h2.7l.4-3.2h-3.1V7.8c0-.9.3-1.5 1.6-1.5h1.7V3.4c-.3 0-1.3-.1-2.4-.1-2.4 0-4 1.4-4 4.1v2.4H7.700V13h2.700v8h3.100Z',
  instagram:
    'M7.5 2h9A5.5 5.5 0 0 1 22 7.5v9a5.5 5.5 0 0 1-5.5 5.5h-9A5.5 5.5 0 0 1 2 16.5v-9A5.5 5.5 0 0 1 7.5 2Zm0 2A3.5 3.5 0 0 0 4 7.5v9A3.5 3.5 0 0 0 7.5 20h9a3.5 3.5 0 0 0 3.5-3.5v-9A3.5 3.5 0 0 0 16.5 4h-9ZM12 7a5 5 0 1 1 0 10 5 5 0 0 1 0-10Zm0 2a3 3 0 1 0 0 6 3 3 0 0 0 0-6Zm5.3-3.3a1.2 1.2 0 1 1 0 2.400 1.200 1.200 0 0 1 0-2.400Z',
  youtube:
    'M21.600 7.200a2.500 2.500 0 0 0-1.800-1.800C18.200 5 12 5 12 5s-6.200 0-7.800.4A2.500 2.500 0 0 0 2.400 7.200C2 8.800 2 12 2 12s0 3.200.4 4.800a2.500 2.500 0 0 0 1.800 1.800C5.800 19 12 19 12 19s6.200 0 7.800-.4a2.500 2.500 0 0 0 1.800-1.800c.4-1.600.4-4.800.4-4.800s0-3.200-.4-4.800ZM10 15V9l5.200 3L10 15Z',
} as const;
const labels = { facebook: 'Facebook', instagram: 'Instagram', youtube: 'YouTube' } as const;

const links = (Object.keys(icons) as (keyof typeof icons)[])
  .filter((k) => site.social[k])
  .map((k) => ({ href: site.social[k], label: labels[k], path: icons[k] }));
---

{links.length > 0 && (
  <ul class="social">
    {links.map((l) => (
      <li>
        <a href={l.href} target="_blank" rel="noopener noreferrer me" aria-label={l.label}>
          <svg viewBox="0 0 24 24" width="22" height="22" aria-hidden="true" focusable="false"><path d={l.path} fill="currentColor" fill-rule="evenodd" /></svg>
        </a>
      </li>
    ))}
  </ul>
)}
