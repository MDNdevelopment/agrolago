---
export interface Props {
  items: { q: string; a: string }[];
}
const { items } = Astro.props;
---

<div>
  {items.map((it, i) => (
    <details class="faq-item" data-faq open={i === 0}>
      <summary>
        <span>{it.q}</span>
        <span class="faq-plus" aria-hidden="true"></span>
      </summary>
      <div class="faq-answer"><div>{it.a}</div></div>
    </details>
  ))}
</div>
