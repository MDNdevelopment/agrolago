---
import Base from '../layouts/Base.astro';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import { getT } from '../i18n';
const en = getT('en').ui;
const es = getT('es').ui;
---

<Base lang="es" title={es.notFoundTitle} noindex>
  <Nav lang="es" />
  <main id="main" class="section" style="min-height:70svh;display:grid;align-items:center">
    <div class="wrap">
      <h1 class="h-hero" data-split data-hero>{es.notFoundTitle}</h1>
      <p class="lead" style="margin-top:1.5rem">{es.notFoundText} · {en.notFoundText}</p>
      <div style="display:flex;flex-wrap:wrap;gap:.9rem;margin-top:2rem">
        <a class="btn btn-solid" href="/">{es.notFoundBack}</a>
        <a class="btn" href="/en">{en.notFoundBack}</a>
      </div>
    </div>
  </main>
  <Footer lang="es" />
</Base>
