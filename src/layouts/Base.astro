---
import '../styles/global.css';
import { Font } from 'astro:assets';
import { ClientRouter } from 'astro:transitions';
import { getT, localePath, type Lang, type PageKey } from '../i18n';
import Seo from '../components/Seo.astro';
import JsonLd from '../components/JsonLd.astro';
export interface Props {
  lang: Lang;
  page?: PageKey;
  title: string;
  description?: string;
  image?: string;
  noindex?: boolean;
  jsonLd?: Record<string, unknown>[];
}
const { lang, page, title, description, image, noindex, jsonLd } = Astro.props;
const t = getT(lang);
const path = localePath(lang, page ?? '');
---

<!doctype html>
<html lang={t.htmlLang} transition:animate="none">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <!-- Pre-oculta solo el arranque del hero cuando habrá animación. Sin JS o con reduced-motion todo se ve; salvaguarda de 4 s. -->
    <script is:inline>
      if (!matchMedia('(prefers-reduced-motion: reduce)').matches) {
        document.documentElement.classList.add('has-motion');
        setTimeout(function () { document.documentElement.classList.remove('has-motion'); }, 4000);
      }
    </script>
    <link rel="icon" type="image/png" href="/favicon.png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <Font cssVariable="--font-display-src" preload />
    <Font cssVariable="--font-body-src" preload />
    <Seo {lang} {page} {title} {description} {path} {image} {noindex} />
    <JsonLd {lang} nodes={jsonLd} />
    <ClientRouter fallback="none" />
    <slot name="head" />
  </head>
  <body>
    <slot />
    <div class="page-curtain" data-page-curtain aria-hidden="true" transition:persist="curtain"></div>
    <script>
      import '../scripts/boot.ts';
    </script>
  </body>
</html>
